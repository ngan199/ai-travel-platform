travel:TravelScheme rdf:type skos:ConceptScheme ;
  dc:creator <https://github.com/ngan199/travel-ai-platform> ;
  skos:definition "A mid-level SKOS taxonomy for a travel AI knowledge graph covering destinations, venues, experiences, lodging, transport, and traveler content"@en ;
  skos:prefLabel "Travel AI Knowledge Graph Concept Scheme"@en
 .

travel:Tourism rdf:type skos:Concept ;
